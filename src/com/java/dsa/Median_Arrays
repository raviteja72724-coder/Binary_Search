package binary_search;

import static java.lang.System.out;

public class Median_Arrays {
    public static double findMedian(int[] arr1,int[] arr2)
    {
        if(arr1.length>arr2.length)
        {
            return findMedian(arr2,arr1);
        }
        int n1 = arr1.length;
        int n2 = arr2.length;
        int total = n1 + n2;
        int start = 0;
        int end = n1;

        while(start<=end)
        {
            int mid1 = start + (end-start)/2;
            int mid2 = (total+1)/2 - mid1;

            int left1 = (mid1==0) ? Integer.MIN_VALUE : arr1[mid1-1];
            int right1 = (mid1==n1) ? Integer.MAX_VALUE : arr1[mid1];
            int left2 = (mid2==0) ? Integer.MIN_VALUE : arr2[mid2-1];
            int right2 = (mid2==n2) ? Integer.MAX_VALUE : arr2[mid2];

            if(left1<=right2 && left2<=right1)
            {
                if(total % 2 == 1)
                {
                    return Math.max(left1,left2);
                }else{
                    return ((double) Math.max(left1,left2) + Math.min(right1,right2))/2;
                }
            }
            else if (left1>right2)
            {
                end = mid1 - 1;
            }
            else {
                start = mid1 + 1;
            }
        }
        return -1;
    }

    public static void main(String[] args) {
        int[] arr1 = {1,2};
        int[] arr2 = {3,4};
        out.println(findMedian(arr1,arr2));
    }
}
